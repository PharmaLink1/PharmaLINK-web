# Copy to .env.local for local development (.env.local is gitignored).
# Base URL of the PharmaLink backend API. Local backend default:
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudinary unsigned browser upload for the pharmacist degree certificate image.
# Required for the pharmacist signup flow. Setup:
#   Cloudinary console > Settings > Upload > Add upload preset
#   - Mode: Unsigned
#   - Allowed formats: jpg, png, webp (max 5 MB)
#   - Optionally lock the folder to pharmalink/certificates
# Only the public cloud name and unsigned preset live here. Never add the API
# key or secret to this file or to any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your-cloud-name>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<your-unsigned-upload-preset>
